PORT=5065
MONGODB_URI=
# Publieke URL van deze app (voor screenshot-links in GitHub-issues)
PUBLIC_URL=http://localhost:5065

# GitHub is optioneel. Zonder GITHUB_TOKEN wordt er geen GitHub-issue gemaakt.
# Zet GITHUB_ENABLED=false om GitHub uit te zetten terwijl het token blijft staan.
GITHUB_ENABLED=
GITHUB_REPO=johnverberne/projects-captainjohn
GITHUB_ASSETS_REPO=johnverberne/feedback
GITHUB_TOKEN=
GITHUB_LABELS=feedback
GITHUB_PROJECT_NUMBER=

# Codeberg is optioneel. Zonder CODEBERG_TOKEN wordt er geen Codeberg-issue gemaakt.
# Zet CODEBERG_ENABLED=false om Codeberg uit te zetten terwijl het token blijft staan.
CODEBERG_ENABLED=
CODEBERG_URL=https://codeberg.org
CODEBERG_REPO=johnverberne/projects-captainjohn
CODEBERG_TOKEN=

# Toegestane origins voor screenshot-intake (komma-gescheiden). Leeg = alle.
ALLOWED_ORIGINS=http://localhost:5055,http://localhost:5173,https://projects.captainjohn.nl,https://projects-captainjohn-production.up.railway.app
