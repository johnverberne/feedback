PORT=5065
MONGODB_URI=
# Publieke URL van deze app (voor screenshot-links in GitHub-issues)
PUBLIC_URL=http://localhost:5065

# Repo waar issues naartoe gaan
GITHUB_REPO=johnverberne/projects-captainjohn
# Repo waar screenshots heen gaan (publiek, zodat GitHub ze kan tonen)
GITHUB_ASSETS_REPO=johnverberne/feedback
GITHUB_TOKEN=
# Optioneel: extra label naast "feedback"
GITHUB_LABELS=feedback

# Optioneel: GitHub Project (Projects v2) nummer; vereist token-scope read:project + project
GITHUB_PROJECT_NUMBER=

# Codeberg (Forgejo) — issues naast GitHub
CODEBERG_URL=https://codeberg.org
CODEBERG_REPO=johnverberne/projects-captainjohn
CODEBERG_TOKEN=

# Toegestane origins voor screenshot-intake (komma-gescheiden). Leeg = alle.
ALLOWED_ORIGINS=http://localhost:5055,http://localhost:5173,https://projects-captainjohn-production.up.railway.app
